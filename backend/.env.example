COMPANY_NAME=ErwinCo
GEMINI_API_KEY=
ADMIN_API_KEY=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-separate-long-random-secret
GEMINI_AGENT_MODEL=gemini-3.5-flash
GEMINI_RAG_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
# Standard paid Gemini 3.5 Flash rates, USD per 1M tokens; update if the model changes.
GEMINI_AGENT_INPUT_USD_PER_MILLION=1.50
GEMINI_AGENT_OUTPUT_USD_PER_MILLION=9.00
# Hosted Postgres URLs (Neon, Vercel Postgres) can be pasted as given, including ?sslmode=require
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5433/support
QDRANT_URL=http://localhost:6333
# Qdrant Cloud only; leave empty for local Docker
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_COLLECTION=support_manual
RAG_MIN_SIMILARITY=0.5
RAG_MIN_KEYWORD_OVERLAP=0.25
# Upstash: use the rediss:// (TLS) URL
# Local Redis: use redis://
REDIS_URL=redis://localhost:6379/0
# Comma-separated; add the deployed frontend URL, e.g. https://your-frontend.vercel.app
FRONTEND_ORIGINS=http://localhost:5173
MAX_AGENT_STEPS=6

LOG_LEVEL=INFO
